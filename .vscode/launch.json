{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Example: simple",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/examples/simple"
		},
		{
			"name": "Example: redis",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/examples/redis"
		},
		{
			"name": "Example: trace",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/examples/trace"
		},
		{
			"name": "Debug current file",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${file}"
		},
		{
			"name": "Debug current test",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${fileDirname}",
			"args": [
				"-test.run",
				"${selectedText}"
			]
		},
		{
			"name": "Debug package tests",
			"type": "go",
			"request": "launch",
			"mode": "test",
			"program": "${fileDirname}",
			"buildFlags": [
				"-race"
			]
		}
	]
}
